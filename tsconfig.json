{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "lib": [
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ],
        "jsx": "preserve",
        "jsxImportSource": "vue",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "paths": {
            "@/*": ["./resources/js/*"]
        },
        "types": [
            "vite/client"
        ],
        "resolveJsonModule": true,
        "allowJs": true,
        "sourceMap": true,
        "noEmit": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        // Force la cohérence des casses dans les imports · sans ça,
        // un import `@/utils/...` (lowercase) compilerait sur Windows
        // (file system case-insensitive) mais casserait en prod Linux
        // (case-sensitive). Cf. doctrine `Utils/` PascalCase Floty.
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        // Ajoute `undefined` aux accès indexés · prévient les bugs
        // silencieux du genre `array[i]?.foo` quand `i` est out of range.
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.d.ts",
        "resources/js/**/*.tsx",
        "resources/js/**/*.vue",
        "tests/js/**/*.ts"
    ],
    "exclude": [
        "resources/js/actions/**"
    ]
}
